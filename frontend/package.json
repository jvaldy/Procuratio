{
  "name": "procuratio-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "20.20.2",
    "npm": "10.8.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "capture:playwright": "playwright test tests/capture-docs.spec.ts --workers=1",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:pos": "playwright test tests/pos.spec.ts"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "6.3.0",
    "@stripe/stripe-js": "9.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.3"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
